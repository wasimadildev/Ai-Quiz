@model Quiz
@{
    ViewData["Title"] = "Quiz Details";
}
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h1 class="h3">@Model.Title</h1>
        <p class="text-muted mb-2">@Model.Subject - @Model.Topic</p>
        <span class="badge text-bg-light border">@Model.Difficulty</span>
        <span class="badge text-bg-light border">@Model.Questions.Count questions</span>
        @if (User.IsInRole("Student"))
        {
            <div class="mt-3"><a class="btn btn-primary" asp-controller="Student" asp-action="Attempt" asp-route-id="@Model.Id">Start Quiz</a></div>
        }
    </div>
</div>
<div class="card shadow-sm">
    <div class="card-body">
        <h2 class="h5 mb-3">Questions Preview</h2>
        <ol>
            @foreach (var question in Model.Questions)
            {
                <li class="mb-2">@question.Text</li>
            }
        </ol>
    </div>
</div>
