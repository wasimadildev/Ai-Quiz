@model IEnumerable<ApplicationUser>
@{
    ViewData["Title"] = "Students";
}

<div class="dashboard-header">
    <h1><i class="fas fa-users me-2 text-gradient"></i>Students</h1>
    <a class="btn btn-outline-secondary" asp-action="Dashboard"><i class="fas fa-arrow-left me-1"></i>Back to Dashboard</a>
</div>

<div class="mb-4">
    <div class="position-relative">
        <i class="fas fa-search position-absolute" style="left:1rem; top:50%; transform:translateY(-50%); color:var(--gray-400);"></i>
        <input type="text" id="studentSearchInput" class="form-control" style="padding-left:2.75rem;" placeholder="Search students by name or email..." oninput="searchStudents()" />
    </div>
</div>

<div id="studentsTableContainer">
    <div class="card" style="border:none; border-radius:var(--radius-lg); box-shadow:var(--shadow-sm);">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="studentsTable">
                <thead>
                    <tr>
                        <th><i class="fas fa-user me-1"></i>Name</th>
                        <th><i class="fas fa-envelope me-1"></i>Email</th>
                        <th><i class="fas fa-shield-halved me-1"></i>Role</th>
                        <th class="text-end"><i class="fas fa-cogs me-1"></i>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4">
                            <div class="empty-state py-4">
                                <div class="empty-icon" style="font-size:2.5rem;"><i class="fas fa-users-slash"></i></div>
                                <h3 style="font-size:1rem;">No students found</h3>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var student in Model)
                    {
                        <tr class="student-row" data-name="@student.FullName?.ToLower()" data-email="@student.Email?.ToLower()">
                            <td style="font-weight:600;">
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width:36px; height:36px; background:var(--gradient-primary); border-radius:var(--radius-sm); display:flex; align-items:center; justify-content:center; color:white; font-weight:700; font-size:0.8rem; flex-shrink:0;">
                                        @(student.FullName?.Length > 0 ? student.FullName[0].ToString().ToUpper() : "?")
                                    </div>
                                    @student.FullName
                                </div>
                            </td>
                            <td style="color:var(--gray-500);">@student.Email</td>
                            <td>
                                <span class="badge text-bg-primary"><i class="fas fa-user me-1"></i>Student</span>
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="StudentDetail" asp-route-id="@student.Id"><i class="fas fa-eye me-1"></i>View</a>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    var searchTimeout;
    function searchStudents() {
        clearTimeout(searchTimeout);
        var query = document.getElementById('studentSearchInput').value.trim();
        searchTimeout = setTimeout(function () {
            if (query.length === 0) {
                filterLocalStudents(query);
                return;
            }
            fetch('/Teacher/SearchStudents?query=' + encodeURIComponent(query))
                .then(function (response) { return response.json(); })
                .then(function (data) {
                    var tbody = document.querySelector('#studentsTable tbody');
                    if (data.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="4"><div class="empty-state py-4"><div class="empty-icon" style="font-size:2.5rem;"><i class="fas fa-users-slash"></i></div><h3 style="font-size:1rem;">No students found</h3></div></td></tr>';
                    } else {
                        var html = '';
                        data.forEach(function (s) {
                            var initial = s.fullName && s.fullName.length > 0 ? s.fullName[0].toUpperCase() : '?';
                            html += '<tr class="student-row">';
                            html += '<td style="font-weight:600;"><div class="d-flex align-items-center gap-2"><div style="width:36px; height:36px; background:var(--gradient-primary); border-radius:var(--radius-sm); display:flex; align-items:center; justify-content:center; color:white; font-weight:700; font-size:0.8rem; flex-shrink:0;">' + initial + '</div>' + (s.fullName || '') + '</div></td>';
                            html += '<td style="color:var(--gray-500);">' + (s.email || '') + '</td>';
                            html += '<td><span class="badge text-bg-primary"><i class="fas fa-user me-1"></i>Student</span></td>';
                            html += '<td class="text-end"><a class="btn btn-sm btn-outline-secondary" href="/Teacher/StudentDetail/' + s.id + '"><i class="fas fa-eye me-1"></i>View</a></td>';
                            html += '</tr>';
                        });
                        tbody.innerHTML = html;
                    }
                })
                .catch(function () {
                    filterLocalStudents(query);
                });
        }, 300);
    }

    function filterLocalStudents(query) {
        var rows = document.querySelectorAll('.student-row');
        var q = query.toLowerCase();
        rows.forEach(function (row) {
            var name = row.getAttribute('data-name') || '';
            var email = row.getAttribute('data-email') || '';
            if (name.includes(q) || email.includes(q)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }
</script>
