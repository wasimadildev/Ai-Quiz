@model IEnumerable<AiQuiz.Models.StudentAttempt>
@{
    var student = (AiQuiz.Models.ApplicationUser)ViewBag.Student;
    ViewData["Title"] = "Student Detail - " + student.FullName;
}

<div class="dashboard-header">
    <div>
        <h1><i class="fas fa-user me-2 text-gradient"></i>@student.FullName</h1>
        <p style="color:var(--gray-500); margin:0;">@student.Email</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Students"><i class="fas fa-arrow-left me-1"></i>Back to Students</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card"><div class="stat-label">Total Attempts</div><div class="stat-value">@Model.Count()</div></div>
    </div>
    <div class="col-md-3">
        <div class="stat-card"><div class="stat-label">Completed</div><div class="stat-value">@Model.Count(a => a.Status == "Completed")</div></div>
    </div>
    <div class="col-md-3">
        <div class="stat-card"><div class="stat-label">In Progress</div><div class="stat-value">@Model.Count(a => a.Status == "InProgress")</div></div>
    </div>
    <div class="col-md-3">
        <div class="stat-card"><div class="stat-label">Violations</div><div class="stat-value">@Model.Sum(a => a.ViolationCount)</div></div>
    </div>
</div>

<div class="card" style="border:none; border-radius:var(--radius-lg); box-shadow:var(--shadow-sm);">
    <div class="card-header" style="background:none; border-bottom:1px solid var(--gray-100); padding:1rem 1.5rem;">
        <h5 style="margin:0; font-weight:700;"><i class="fas fa-list me-2"></i>Quiz Attempts</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Quiz</th>
                    <th>Subject</th>
                    <th>Status</th>
                    <th>Score</th>
                    <th>Date</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6">
                            <div class="empty-state py-4">
                                <div class="empty-icon" style="font-size:2.5rem;"><i class="fas fa-clipboard"></i></div>
                                <h3 style="font-size:1rem;">No attempts yet</h3>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var attempt in Model)
                    {
                        var result = attempt.Result;
                        var scoreText = result != null ? $"{result.TotalMarksObtained} / {result.TotalMaxMarks}" : "-";
                        var pct = result?.Percentage ?? 0;
                        <tr>
                            <td style="font-weight:600;">@attempt.Quiz.Title</td>
                            <td style="color:var(--gray-500);">@attempt.Quiz.Subject</td>
                            <td>
                                @if (attempt.Status == "Completed")
                                {
                                    <span class="badge text-bg-success"><i class="fas fa-check me-1"></i>Completed</span>
                                }
                                else if (attempt.Status == "InProgress")
                                {
                                    <span class="badge text-bg-warning"><i class="fas fa-spinner me-1"></i>In Progress</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">@attempt.Status</span>
                                }
                            </td>
                            <td>
                                <span style="font-weight:700; color:@(pct >= 50 ? "var(--success)" : "var(--danger)");">
                                    @scoreText
                                </span>
                                @if (result != null)
                                {
                                    <small style="color:var(--gray-400);">(@pct.ToString("F0")%)</small>
                                }
                            </td>
                            <td style="color:var(--gray-500); font-size:0.85rem;">@(attempt.SubmittedAt?.ToString("MMM dd, yyyy HH:mm") ?? attempt.StartedAt.ToString("MMM dd, yyyy HH:mm"))</td>
                            <td class="text-end">
                                @if (attempt.Status == "Completed")
                                {
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Review" asp-route-attemptId="@attempt.Id"><i class="fas fa-eye me-1"></i>Review</a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
