@model MonitoringViewModel
@{
    ViewData["Title"] = "Monitor Quiz";
}

<div class="dashboard-header">
    <h1><i class="fas fa-desktop me-2 text-gradient"></i>Monitor: @Model.QuizTitle</h1>
    <a class="btn btn-outline-secondary" asp-action="Quizzes"><i class="fas fa-arrow-left me-1"></i>Back to Quizzes</a>
</div>

@if (!Model.Entries.Any())
{
    <div class="empty-state">
        <div class="empty-icon"><i class="fas fa-users-slash"></i></div>
        <h3>No attempts yet</h3>
        <p>Students haven't started this quiz yet.</p>
    </div>
}
else
{
    <div class="card" style="border:none; border-radius:var(--radius-lg); box-shadow:var(--shadow-sm);">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th><i class="fas fa-user me-1"></i>Student</th>
                        <th><i class="fas fa-hashtag me-1"></i>Roll / Email</th>
                        <th><i class="fas fa-play me-1"></i>Start Time</th>
                        <th><i class="fas fa-stop me-1"></i>End Time</th>
                        <th><i class="fas fa-clock me-1"></i>Duration</th>
                        <th><i class="fas fa-star me-1"></i>Score</th>
                        <th><i class="fas fa-toggle-on me-1"></i>Status</th>
                        <th><i class="fas fa-triangle-exclamation me-1"></i>Violations</th>
                        <th class="text-end"><i class="fas fa-cogs me-1"></i>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var entry in Model.Entries)
                {
                    <tr>
                        <td style="font-weight:600;">@entry.StudentName</td>
                        <td style="color:var(--gray-500);">@(entry.RollNumber ?? "N/A")</td>
                        <td style="font-size:0.85rem;">@entry.StartTime.ToString("MMM dd, hh:mm tt")</td>
                        <td style="font-size:0.85rem;">@(entry.EndTime?.ToString("MMM dd, hh:mm tt") ?? "—")</td>
                        <td><span class="badge text-bg-primary">@entry.TotalTime</span></td>
                        <td style="font-weight:700;">@entry.Score / @entry.MaxScore</td>
                        <td>
                            @switch (entry.Status)
                            {
                                case "InProgress":
                                    <span class="badge text-bg-primary"><i class="fas fa-spinner me-1"></i>In Progress</span>
                                    break;
                                case "Completed":
                                    <span class="badge text-bg-success"><i class="fas fa-check-circle me-1"></i>Completed</span>
                                    break;
                                case "Failed":
                                    <span class="badge text-bg-danger"><i class="fas fa-times-circle me-1"></i>Failed</span>
                                    break;
                                default:
                                    <span class="badge text-bg-secondary"><i class="fas fa-minus-circle me-1"></i>@entry.Status</span>
                                    break;
                            }
                        </td>
                        <td>
                            @if (entry.ViolationCount > 0)
                            {
                                <span class="badge text-bg-danger"><i class="fas fa-exclamation-triangle me-1"></i>@entry.ViolationCount</span>
                            }
                            else
                            {
                                <span class="badge text-bg-success">0</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="MonitorDetail" asp-route-attemptId="@entry.AttemptId"><i class="fas fa-eye me-1"></i>View Detail</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
