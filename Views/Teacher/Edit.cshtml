@model QuizFormViewModel
@{
    ViewData["Title"] = "Edit Quiz";
}
<div class="dashboard-header">
    <h1><i class="fas fa-pen-to-square me-2 text-gradient"></i>Edit Quiz</h1>
</div>
<div class="card quiz-form-card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input asp-for="Id" type="hidden" />
            <partial name="_QuizForm" model="Model" />
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary btn-lg"><i class="fas fa-save me-2"></i>Save Changes</button>
                <a class="btn btn-outline-secondary btn-lg" asp-action="Quizzes"><i class="fas fa-times me-1"></i>Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
