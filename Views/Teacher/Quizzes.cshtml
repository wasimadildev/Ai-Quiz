@model IEnumerable<Quiz>
@{
    ViewData["Title"] = "My Quizzes";
}
<div class="dashboard-header">
    <h1><i class="fas fa-folder-open me-2 text-gradient"></i>My Quizzes</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="Create"><i class="fas fa-plus me-1"></i>Create Quiz</a>
        <a class="btn btn-primary" asp-action="Generate"><i class="fas fa-wand-magic-sparkles me-1"></i>Generate with AI</a>
    </div>
</div>
@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-icon"><i class="fas fa-inbox"></i></div>
        <h3>No quizzes yet</h3>
        <p>Create your first quiz or generate one with AI.</p>
    </div>
}
else
{
    <div class="table-responsive card" style="border:none; border-radius:var(--radius-lg); box-shadow:var(--shadow-sm);">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th><i class="fas fa-heading me-1"></i>Title</th>
                    <th><i class="fas fa-book me-1"></i>Subject</th>
                    <th><i class="fas fa-circle-question me-1"></i>Questions</th>
                    <th><i class="fas fa-toggle-on me-1"></i>Status</th>
                    <th class="text-end"><i class="fas fa-cogs me-1"></i>Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var quiz in Model)
            {
                <tr>
                    <td style="font-weight:600;">@quiz.Title</td>
                    <td style="color:var(--gray-500);">@quiz.Subject</td>
                    <td><span class="badge text-bg-primary">@quiz.Questions.Count</span></td>
                    <td>
                        <span class="badge @(quiz.IsPublished ? "text-bg-success" : "text-bg-secondary")">
                            <i class="fas @(quiz.IsPublished ? "fa-check-circle" : "fa-pen") me-1"></i>
                            @(quiz.IsPublished ? "Published" : "Draft")
                        </span>
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@quiz.Id"><i class="fas fa-pen me-1"></i>Edit</a>
                        @if (quiz.IsPublished)
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-action="Monitor" asp-route-id="@quiz.Id"><i class="fas fa-desktop me-1"></i>Monitor</a>
                        }
                        @if (!quiz.IsPublished)
                        {
                            <form asp-action="Publish" asp-route-id="@quiz.Id" method="post" class="d-inline">
                                <button class="btn btn-sm btn-outline-success"><i class="fas fa-globe me-1"></i>Publish</button>
                            </form>
                        }
                        <form asp-action="Delete" asp-route-id="@quiz.Id" method="post" class="d-inline">
                            <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this quiz?')"><i class="fas fa-trash me-1"></i>Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
