@{
    ViewData["Title"] = "Home";
}
<section class="hero-section">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <h1 class="animate-fadeInUp">AI-Powered Quiz<br/>Generator & Grader</h1>
            <p class="lead animate-fadeInUp stagger-1">Create quizzes manually or with AI, share via join codes, with anti-cheating protection and instant grading.</p>
            <div class="d-flex gap-3 flex-wrap hero-actions animate-fadeInUp stagger-2">
                <a class="btn btn-light btn-lg" asp-controller="Account" asp-action="Register"><i class="fas fa-rocket me-2"></i>Get Started Free</a>
                <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Login"><i class="fas fa-sign-in me-2"></i>Sign In</a>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="hero-features animate-fadeInUp stagger-3">
                <h2><i class="fas fa-star me-2"></i>Features</h2>
                <ul class="list-unstyled mb-0">
                    <li>AI-powered quiz generation (Gemini)</li>
                    <li>Manual quiz builder (MCQ, T/F, Short/Long)</li>
                    <li>Private quiz sharing via join codes</li>
                    <li>Anti-cheating protection & fullscreen</li>
                    <li>Automatic + manual grading</li>
                    <li>Real-time monitoring dashboard</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<div class="row g-4 mt-2">
    <div class="col-md-4 animate-fadeInUp stagger-1">
        <div class="card hover-lift" style="text-align:center; padding: 2rem 1.5rem;">
            <div style="width:60px; height:60px; margin:0 auto 1rem; background:rgba(99,102,241,0.1); border-radius:16px; display:flex; align-items:center; justify-content:center; font-size:1.5rem; color:#6366f1;">
                <i class="fas fa-wand-magic-sparkles"></i>
            </div>
            <h3 style="font-size:1.1rem; font-weight:700;">AI Generation</h3>
            <p style="color:var(--gray-500); font-size:0.9rem; margin-bottom:0;">Generate quizzes with Gemini AI or build manually</p>
        </div>
    </div>
    <div class="col-md-4 animate-fadeInUp stagger-2">
        <div class="card hover-lift" style="text-align:center; padding: 2rem 1.5rem;">
            <div style="width:60px; height:60px; margin:0 auto 1rem; background:rgba(236,72,153,0.1); border-radius:16px; display:flex; align-items:center; justify-content:center; font-size:1.5rem; color:#ec4899;">
                <i class="fas fa-shield-halved"></i>
            </div>
            <h3 style="font-size:1.1rem; font-weight:700;">Anti-Cheating</h3>
            <p style="color:var(--gray-500); font-size:0.9rem; margin-bottom:0;">Tab tracking, fullscreen mode, violation limits</p>
        </div>
    </div>
    <div class="col-md-4 animate-fadeInUp stagger-3">
        <div class="card hover-lift" style="text-align:center; padding: 2rem 1.5rem;">
            <div style="width:60px; height:60px; margin:0 auto 1rem; background:rgba(6,182,212,0.1); border-radius:16px; display:flex; align-items:center; justify-content:center; font-size:1.5rem; color:#06b6d4;">
                <i class="fas fa-key"></i>
            </div>
            <h3 style="font-size:1.1rem; font-weight:700;">Private Sharing</h3>
            <p style="color:var(--gray-500); font-size:0.9rem; margin-bottom:0;">Join codes, passwords, and student assignment</p>
        </div>
    </div>
</div>
