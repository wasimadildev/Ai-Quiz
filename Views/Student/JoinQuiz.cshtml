@model JoinQuizViewModel
@{
    ViewData["Title"] = "Join Quiz";
}

<div class="d-flex align-items-center justify-content-center" style="min-height:60vh;">
<div class="auth-card" style="max-width: 480px; width:100%;">
    <div class="card-body">
        <div class="auth-header">
            <div class="auth-icon">
                <i class="fas fa-key"></i>
            </div>
            <h1>Join Quiz</h1>
            <p>Enter the join code provided by your teacher</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle"></i>
                @Model.ErrorMessage
            </div>
        }

        <form asp-action="JoinQuiz" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="JoinCode" class="form-label">Join Code</label>
                <div class="input-group">
                    <span class="input-group-text" style="border-radius:var(--radius-md) 0 0 var(--radius-md); background:var(--primary-50); border:2px solid var(--gray-200); border-right:none; color:var(--primary);">
                        <i class="fas fa-hashtag"></i>
                    </span>
                    <input asp-for="JoinCode" class="form-control" placeholder="e.g. ABC123" style="border-radius:0 var(--radius-md) var(--radius-md) 0;" autocomplete="off" />
                </div>
                <span asp-validation-for="JoinCode" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label">Password <span class="text-muted" style="font-weight:400;">(optional)</span></label>
                <div class="input-group">
                    <span class="input-group-text" style="border-radius:var(--radius-md) 0 0 var(--radius-md); background:var(--primary-50); border:2px solid var(--gray-200); border-right:none; color:var(--primary);">
                        <i class="fas fa-lock"></i>
                    </span>
                    <input asp-for="Password" class="form-control" type="password" placeholder="Enter quiz password" style="border-radius:0 var(--radius-md) var(--radius-md) 0;" />
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100">
                <i class="fas fa-right-to-bracket me-2"></i>Join Quiz
            </button>
        </form>
    </div>
</div>
</div>
