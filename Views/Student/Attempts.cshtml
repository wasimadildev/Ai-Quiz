@model IEnumerable<StudentAttempt>
@{
    ViewData["Title"] = "Previous Attempts";
}

<div class="dashboard-header">
    <h1><i class="fas fa-clock-rotate-left me-2 text-gradient"></i>Previous Attempts</h1>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-icon"><i class="fas fa-inbox"></i></div>
        <h3>No attempts yet</h3>
        <p>Take a quiz to see your results here.</p>
        <a class="btn btn-primary mt-2" asp-action="JoinQuiz"><i class="fas fa-key me-2"></i>Join a Quiz</a>
    </div>
}
else
{
    <div class="table-responsive card animate-fadeInUp" style="border:none; border-radius:var(--radius-lg); box-shadow:var(--shadow-sm);">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th><i class="fas fa-book me-1"></i>Quiz</th>
                    <th><i class="fas fa-calendar me-1"></i>Date</th>
                    <th><i class="fas fa-star me-1"></i>Score</th>
                    <th><i class="fas fa-percent me-1"></i>Percentage</th>
                    <th><i class="fas fa-circle-info me-1"></i>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var attempt in Model)
            {
                <tr>
                    <td style="font-weight:600;">@attempt.Quiz?.Title</td>
                    <td style="color:var(--gray-500);">@(attempt.SubmittedAt ?? attempt.StartedAt).ToLocalTime().ToString("g")</td>
                    <td>@attempt.Result?.TotalMarksObtained / @attempt.Result?.TotalMaxMarks</td>
                    <td>
                        <span class="badge @(attempt.Result?.IsPass == true ? "text-bg-success" : "text-bg-danger")">
                            @(attempt.Result?.Percentage.ToString("F1"))%
                        </span>
                    </td>
                    <td>
                        @switch (attempt.Status)
                        {
                            case "Completed":
                                <span class="badge text-bg-success"><i class="fas fa-check me-1"></i>Completed</span>
                                break;
                            case "InProgress":
                                <span class="badge text-bg-primary"><i class="fas fa-spinner me-1"></i>In Progress</span>
                                break;
                            case "Failed":
                                <span class="badge text-bg-danger"><i class="fas fa-times me-1"></i>Failed</span>
                                break;
                            case "Cancelled":
                                <span class="badge text-bg-secondary"><i class="fas fa-ban me-1"></i>Cancelled</span>
                                break;
                            default:
                                <span class="badge text-bg-light">@attempt.Status</span>
                                break;
                        }
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Result" asp-route-id="@attempt.Id">
                            <i class="fas fa-eye me-1"></i>View
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
