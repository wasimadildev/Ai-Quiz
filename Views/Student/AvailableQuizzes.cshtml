@model IEnumerable<Quiz>
@{
    ViewData["Title"] = "Available Quizzes";
}
<div class="dashboard-header">
    <h1><i class="fas fa-clipboard-list me-2 text-gradient"></i>Available Quizzes</h1>
</div>
@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-icon"><i class="fas fa-inbox"></i></div>
        <h3>No quizzes available yet</h3>
        <p>Check back later for new quizzes from your teachers.</p>
    </div>
}
else
{
    <div class="row g-4">
    @foreach (var quiz in Model)
    {
        <div class="col-md-6 col-lg-4 animate-fadeInUp">
            <div class="quiz-card">
                <div class="card-body">
                    <h2 class="quiz-title">@quiz.Title</h2>
                    <p class="quiz-meta"><i class="fas fa-book me-1"></i>@quiz.Subject &mdash; @quiz.Topic</p>
                    <div class="quiz-badges">
                        <span class="difficulty-badge @quiz.Difficulty.ToLower()">@quiz.Difficulty</span>
                        <span class="questions-badge"><i class="fas fa-circle-question me-1"></i>@quiz.Questions.Count questions</span>
                    </div>
                </div>
                <div class="card-footer">
                    <a class="btn btn-primary w-100" asp-action="Attempt" asp-route-id="@quiz.Id"><i class="fas fa-play me-1"></i>Start Quiz</a>
                </div>
            </div>
        </div>
    }
    </div>
}
