@model DashboardViewModel
@{
    ViewData["Title"] = "Student Dashboard";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Student Dashboard</h1>
    <a class="btn btn-primary" asp-action="AvailableQuizzes">View Quizzes</a>
</div>
<div class="row g-3">
    <div class="col-md-6"><div class="card stat-card"><div class="card-body"><div class="text-muted">Published Quizzes</div><div class="display-6">@Model.PublishedQuizzes</div></div></div></div>
    <div class="col-md-6"><div class="card stat-card"><div class="card-body"><div class="text-muted">My Attempts</div><div class="display-6">@Model.Attempts</div></div></div></div>
</div>
